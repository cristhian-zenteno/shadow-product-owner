# Copy this file to `.env` and fill in your values.
# Never commit `.env` — it is listed in `.gitignore`.

# Required: NVIDIA NIM API key (free tier at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: legacy Google Gemini key (only if using Google instead of NVIDIA)
# GOOGLE_API_KEY=
